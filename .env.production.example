# Copy to .env.production (git-ignored) and fill in real values.
# The desktop build bundles this file via package.json > build.files, so it must
# exist locally before running `pnpm desktop:build`.

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-app-url

# Postgres connection string
DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client — it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# DeepL translation (server-only)
DEEPL_API_KEY=
# Optional override, defaults to the free tier endpoint
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# LiveKit calls
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
